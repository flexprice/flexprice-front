npm run format
npx lint-staged

# Dark-theme migration guards. verify:theme pins each token's light value to its Tailwind source;
# verify:light proves each CLASS was mapped to the right token, which the token guard cannot see.
npm run verify:theme
npm run verify:light
# Catches committing src/index.css without tailwind.config.js (or vice versa).
npm run verify:tokens-staged
# The widget ships its own stylesheet; tokens must be mirrored there too.
npm run verify:exportable

npm run build
