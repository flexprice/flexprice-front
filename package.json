    "iso-country-currency": "^0.7.2",
    "lucide-react": "^1.55.0",
    "posthog-js": "^1.438.7",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^17.0.16",
    "react-icons": "^5.7.0",
    "react-router": "^8.4.0",
    "react-svg": "^19.2.1",
    "recharts": "^3.10.1",
    "svix-react": "^1.13.9",
