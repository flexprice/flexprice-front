{
  "name": "flexprice-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "generate-meta": "node scripts/generate-meta.js",
    "build": "tsc -b && vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write src",
    "preview": "vite preview",
    "prepare": "husky",
    "start": "vite --port 3000 --host 0.0.0.0",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src vite.config.ts vitest.config.ts .storybook e2e playwright.config.ts",
    "build:ui": "vite build --config vite.flexprice-ui.config.ts",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:public": "playwright test --project=public",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:critical": "playwright test --project=e2e --grep @critical",
    "test:e2e:regression": "playwright test --project=e2e --grep @regression",
    "test:e2e:rbac": "playwright test --project=rbac",
    "test:e2e:visual": "playwright test --project=visual",
    "test:e2e:visual:update": "playwright test --project=visual --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@csvbox/react": "^1.1.16",
