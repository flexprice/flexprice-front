{
	// The root tsconfig includes only `src`, so without this the E2E suite and the
	// Playwright config would never be typechecked — a broken page object would
	// surface as a runtime failure mid-run instead of at build time.
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["e2e/**/*.ts", "playwright.config.ts"]
}
